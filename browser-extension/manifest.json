{
    "manifest_version": 3,
    "name": "LockIn Website Tracker",
    "version": "1.0",
    "description": "Tracks websites and warns users about distraction sites.",
    "permissions": [
        "tabs"
    ],
    "host_permissions": [
        "http://localhost:8080/*",
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}